# SIP account dedicated to the live receiver service.
SIP_SERVER=YOUR_SIP_SERVER
SIP_PORT=5060
SIP_NUMBER=YOUR_SIP_NUMBER
SIP_AUTH_NAME=YOUR_SIP_AUTH_USERNAME
SIP_PASSWORD=YOUR_SIP_PASSWORD
SIP_TRANSPORT=udp
SIP_CODEC_ALLOW=ulaw,alaw

# Host SIP and RTP ports exposed by Docker.
HOST_SIP_PORT=5062
RTP_START=11000
RTP_END=11100
LOCAL_NET=192.168.0.0/16
EXTERNAL_ADDRESS=

# Stable udev symlink path for the USB SDR device (see README for udev rule
# setup). Not needed if using PlutoSDR over its default network connection
# rather than USB.
SDR_DEVICE=/dev/sdr-radio

# Which SDR backend to use: sdrplay, rtlsdr, or plutosdr.
SDR_DRIVER=sdrplay

# Tuning shared by all backends. Frequency is fully configurable — this
# project is not tied to any single band or frequency.
SDR_FREQUENCY_KHZ=3699
# lsb, usb, auto (below 10,000 kHz = LSB, at/above = USB, ham convention),
# nfm (narrowband FM), wfm (broadcast-style wideband FM), or am
SDR_MODE=lsb
# Passband edges by magnitude (Hz from carrier); sign is applied automatically
# based on the resolved LSB/USB mode.
SDR_LOW_CUT_HZ=-2700
SDR_HIGH_CUT_HZ=-300
# Only read when SDR_MODE=nfm or wfm. Left commented out on purpose: these
# have mode-dependent defaults (nfm: 5000/16000, matching Marine VHF's
# 16K0F3E emission, e.g. Channel 16 at SDR_FREQUENCY_KHZ=156800; wfm:
# 75000/200000, broadcast FM's standard deviation/channel bandwidth -- see
# README). Docker Compose loads this whole file as the container's
# environment, so an uncommented value here is applied to *every* mode and
# would silently force nfm's narrow settings onto wfm (badly distorted,
# aliased audio). Uncomment only to override the defaults deliberately, and
# remember to re-comment when switching modes.
#SDR_FM_DEVIATION_HZ=5000
#SDR_FM_CHANNEL_BANDWIDTH_HZ=16000
# Empty disables squelch (continuous audio/static, the default). The right
# threshold depends on antenna/gain/hardware -- tune by ear/eye during bring-up.
SDR_SQUELCH_DB=
SDR_SQUELCH_HANG_MS=200
# Empty leaves audio flat for nfm (the default, since two-way FM
# de-emphasis standards vary). wfm defaults to 50 (EU/Finland broadcast
# standard) unless set explicitly here -- see README.
SDR_FM_DEEMPHASIS_US=
# Only read when SDR_MODE=am. Default covers both 8.33kHz and 25kHz VHF
# airband channel spacing; narrow it to 8330 for regions using the tighter
# spacing.
SDR_AM_CHANNEL_BANDWIDTH_HZ=25000
# Digital output gain applied after demodulation; tune by ear during
# bring-up. Left commented out on purpose: the right default depends on
# mode. nfm/wfm's demodulator output is normalized to roughly +/-1.0 at
# full deviation, so 1.0 is a sane starting point; lsb/usb/am output is
# unnormalized raw IQ amplitude (typically well below 1.0), needing a much
# larger gain like 20.0 to reach an audible level. Uncomment only to
# override the mode-dependent default deliberately.
#SDR_AUDIO_GAIN=20.0

SDR_STALE_SECONDS=15
SDR_RETRY_INITIAL_SECONDS=2
SDR_RETRY_MAX_SECONDS=30
# Timeout for `make test-stream`'s hardware smoke test, in seconds.
SDR_TEST_TIMEOUT_SECONDS=20
# Jitter buffer resynchronizes from the maximum back to the target.
SDR_BUFFER_TARGET_MS=250
SDR_BUFFER_MAX_MS=1000

# Only the block matching SDR_DRIVER above is actually read.

# --- SDRplay RSP2pro ---
# Antenna port: a, b, or hiz (Hi-Z, RSP2pro's dedicated high-impedance port)
SDRPLAY_ANTENNA=a
# agc or manual
SDRPLAY_GAIN_MODE=agc
# Used only when SDRPLAY_GAIN_MODE=manual
SDRPLAY_GAIN_REDUCTION_DB=40
SDRPLAY_LNA_STATE=0
# on/off — bias-tee power injection, Antenna A only on RSP2pro
SDRPLAY_BIAS_T=off

# --- RTL-SDR ---
# agc or manual
RTLSDR_GAIN_MODE=agc
# Used only when RTLSDR_GAIN_MODE=manual
RTLSDR_GAIN_DB=30

# --- PlutoSDR ---
# agc or manual
PLUTOSDR_GAIN_MODE=agc
# Used only when PLUTOSDR_GAIN_MODE=manual
PLUTOSDR_GAIN_DB=30

REGISTRATION_RETRY_INTERVAL=30
REGISTRATION_FORBIDDEN_RETRY_INTERVAL=300
